// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String    @id @default(uuid())
  nombre    String
  email     String    @unique
  password  String
  saldo     Float     @default(0.0)
  createdAt DateTime  @default(now())
  cobros    Cobro[]
  recargas  Recarga[]
}

model Unidad {
  id                 String          @id @default(uuid())
  placa              String          @unique
  marca              String
  modelo             String
  tipoUnidad         TipoUnidad 
  capacidadPasajeros Int
  capacidadCargaKg   Float
  kilometrajeActual  Int
  estado             StatusUnidad
  fechaUltMantenimiento DateTime 
  cobros             Cobro[]
  telemetrias        Telemetria[]

  @@index([placa])
}

enum TipoUnidad {
  AUTOBUS
  CAMION
  AUTOMOVIL
}

enum StatusUnidad {
  ACTIVO
  EN_RUTA
  MANTENIMIENTO
  INACTIVO
}

model Cobro {
  id        String      @id @default(uuid())
  monto     Float
  status    StatusCobro @default(APROBADO_ONLINE)
  
  usuarioId String
  usuario   Usuario     @relation(fields: [usuarioId], references: [id])
  
  unidadId  String
  unidad    Unidad      @relation(fields: [unidadId], references: [id])
  
  timestamp DateTime    @default(now())

  @@index([usuarioId])
  @@index([unidadId])
  @@index([timestamp])
}

enum StatusCobro {
  APROBADO_ONLINE
  APROBADO_OFFLINE
  RECHAZADO
}

model Recarga {
  id        String   @id @default(uuid())
  monto     Float
  metodo    String
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  timestamp DateTime @default(now())

  @@index([usuarioId])
}

model Telemetria {
  id        String   @id @default(uuid())
  unidadId  String
  unidad    Unidad   @relation(fields: [unidadId], references: [id])
  latitud   Float
  longitud  Float
  velocidad Float?
  rumbo     Float?
  timestamp DateTime @default(now())

  @@index([unidadId, timestamp])
}